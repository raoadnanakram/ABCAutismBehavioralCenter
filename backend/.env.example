# Copy to backend/.env for local use. On GoDaddy set the same names in the
# app's Environment Variables screen. NEVER commit the real .env file.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/abcautism_db?appName=Cluster0
JWT_SECRET=put-a-long-random-string-here-at-least-32-characters
FRONTEND_URL=https://abcautismbehavioralcenter.com
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=gmail-app-password
OWNER_EMAIL=where-to-receive-notifications@gmail.com

# Admin login (created automatically on server start if it does not exist)
ADMIN_PHONE=03001234567
ADMIN_PASSWORD=choose-a-strong-password
# set to true for ONE deploy if you need to reset the admin password, then remove it
ADMIN_FORCE_RESET=false
