# Copy to backend/.env (local) OR add these in your hosting "Environment Variables" panel.
# Atlas > Connect > Drivers > copy the mongodb+srv:// string. Add /abcautism before the "?".
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/abcautism?retryWrites=true&w=majority
JWT_SECRET=put-a-long-random-string-here
FRONTEND_URL=https://abcautismbehavioralcenter.com
EMAIL_USER=
EMAIL_PASS=
OWNER_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
